# figures/editio.mplstyle — GENERATED by editio-scaffold for venue EDITIO_VENUE (--force to regenerate).
# Sized to the venue's single-column width so the PDF drops onto the page 1:1 — no
# width=\columnwidth post-scaling, ever (it shrinks fonts out of spec; editio-figcheck
# catches it). Double-column figure: figsize=(EDITIO_FULL_W_IN, <height>) after
# plt.style.use(). NEVER save with bbox_inches='tight' — it re-crops the page and changes
# the physical width; constrained_layout (on below) handles fit instead.
# Palette: Okabe-Ito (colorblind-safe; Wong 2011 / Okabe & Ito 2008) — pair it with
# linestyle/marker redundancy so greyscale print survives (see color-accessibility.md).

figure.figsize: EDITIO_FIG_W_IN, EDITIO_FIG_H_IN
figure.constrained_layout.use: True
figure.dpi: 150

savefig.format: pdf
savefig.dpi: 600
pdf.fonttype: 42
ps.fonttype: 42

font.family: serif
font.size: EDITIO_FONT_PT
mathtext.fontset: cm

axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'E69F00', '56B4E9', 'CC79A7', 'F0E442', '000000'])
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6

lines.linewidth: 1.2
lines.markersize: 4
errorbar.capsize: 2

legend.frameon: False
xtick.direction: out
ytick.direction: out
