{
  "_note": "The editio structure gate: every paper section maps to a DEO/DoCO class, like kb-vocab.json gates store writes. policy strict = no ad-hoc sections; tune extended and add orders per project. Class inventory from the published SPAR specs: DoCO https://sparontologies.github.io/doco/current/doco.html (imports DEO), DEO https://sparontologies.github.io/deo/current/deo.html",
  "policy": "strict",
  "classes": {
    "core": [
      "doco:Abstract",
      "deo:Introduction",
      "deo:Motivation",
      "deo:Background",
      "deo:RelatedWork",
      "deo:ProblemStatement",
      "deo:Methods",
      "deo:Materials",
      "deo:Model",
      "deo:Results",
      "deo:Evaluation",
      "deo:Discussion",
      "deo:Conclusion",
      "deo:FutureWork",
      "deo:Contribution",
      "deo:Acknowledgements",
      "doco:Appendix",
      "doco:BibliographicReferenceList"
    ],
    "extended": [
      "deo:DatasetDescription",
      "deo:ExternalResourceDescription",
      "deo:SupplementaryInformationDescription",
      "deo:Scenario",
      "deo:Data",
      "deo:AuthorContribution",
      "deo:Postscript"
    ]
  },
